{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "functions": {
    "api/index.ts": { "maxDuration": 30 }
  },
  "crons": [
    {
      "path": "/jobs/daily",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/jobs/nudges",
      "schedule": "0 16 * * *"
    }
  ]
}
