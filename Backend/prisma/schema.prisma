generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; "rhel-openssl-3.0.x" for the Vercel/AWS serverless runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (Supabase Supavisor, port 6543) for the app runtime.
  url       = env("DATABASE_URL")
  // Direct connection (port 5432) for migrations / DDL — pgbouncer can't run these.
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String                   @id @default(uuid())
  email                 String                   @unique
  passwordHash          String
  role                  String                   @default("MEMBER")
  referralCode          String?                  @unique
  mustChangePassword    Boolean                  @default(false)
  emailVerifiedAt       DateTime?
  discordId             String?                  @unique
  discordUsername       String?
  // ProsperaSub user_id once the member has been mirrored on ProsperaSub.
  // Populated lazily on first provisioning; used to attach subscriptions.
  externalMemberId      String?                  @unique
  // Opaque bearer token behind the member's QR pass. Random (not derived from
  // id) so it can be rotated if a phone is lost without changing identity.
  // Minted lazily the first time the member opens their pass.
  passToken             String?                  @unique
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  profile               Profile?
  membership            Membership?
  residencyApplication  ResidencyApplication?
  subscriptionPlan      SubscriptionPlan?
  communityPlans        CommunityPlanPurchase[]
  payments              Payment[]
  assignedApartment     AssignedApartment?
  mealMenuItems         MealMenuItem[]
  cleaningSchedules     CleaningSchedule[]
  supportTickets        SupportTicket[]
  emailVerification     EmailVerificationToken[]
  passwordResetTokens   PasswordResetToken[]
  auditEvents           AuditEvent[]
  notifications         Notification[]
  maintenanceRequests   MaintenanceRequest[]
  vehicleBookings       VehicleBooking[]
  eventRsvps            EventRsvp[]
}

// A community vehicle members can book (free of charge). Managed by admins.
model Vehicle {
  id            String           @id @default(uuid())
  name          String
  description   String?
  active        Boolean          @default(true)
  photoFileName String?
  photoFileType String?
  photoData     String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  bookings      VehicleBooking[]
}

// A reservation of a vehicle for a date range (inclusive). Status: ACTIVE |
// CANCELLED. Overlap checks live in the service, not the DB, so admins can
// cancel/replace without losing history.
model VehicleBooking {
  id        String   @id @default(uuid())
  vehicleId String
  userId    String
  startDate DateTime
  endDate   DateTime
  status    String   @default("ACTIVE")
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([vehicleId, startDate, endDate])
  @@index([userId])
}

// Knowledge-base article shown in the member Resource Hub. Managed by admins.
model Resource {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  category  String   @default("General")
  body      String // markdown-lite
  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A community event members can RSVP to. Drafts stay unpublished until an
// admin is ready; only published events are visible to members.
model Event {
  id          String      @id @default(uuid())
  title       String
  description String?
  location    String?
  startsAt    DateTime
  endsAt      DateTime?
  // null = unlimited. When set, GOING RSVPs are refused once it's reached.
  capacity    Int?
  published   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  rsvps       EventRsvp[]

  @@index([startsAt])
  @@index([published])
}

// One row per member per event; status is GOING | MAYBE | DECLINED.
// Unique on the pair so changing your answer updates rather than stacks.
model EventRsvp {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  status    String   @default("GOING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

// A member-reported maintenance issue for their unit, worked through an admin queue.
model MaintenanceRequest {
  id            String    @id @default(uuid())
  userId        String
  category      String    @default("General")
  title         String
  description   String
  status        String    @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED
  adminNote     String?
  photoFileName String?
  photoFileType String?
  photoData     String? // base64, optional
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  resolvedAt    DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// In-app notifications shown in the header bell (application status, E-Residency
// review, welcome, etc.). Created by services; read/listed by the owner.
model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String    @default("info") // info | success | warning
  title     String
  body      String?
  link      String? // in-app path, e.g. /account
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Application {
  id         String            @id @default(uuid())
  fullName   String
  email      String            @unique
  phone      String?
  note       String?
  // What the applicant wrote about themselves, and the links they gave, kept
  // separately from the flattened `note` blob. These seed the member's profile
  // bio and links when their account is created, so nobody has to retype what
  // they already told us — see seedProfileFromApplication.
  about      String?
  socialLinksJson String?
  adminNote  String?
  referralCode String?
  referredByUserId String?
  status     String   @default("SUBMITTED")
  apartmentAvailable Boolean?
  paymentLink String?
  paymentStatus String @default("NOT_SENT")
  firstApprovedAt DateTime?
  meetingApprovedAt DateTime?
  paymentLinkSentAt DateTime?
  paymentConfirmedAt DateTime?
  approvedAt DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

// Holds a submitted-but-not-yet-email-confirmed application. The applicant enters
// the 6-digit code we email them; on success the real Application is created from
// `payloadJson` and this row is deleted.
model ApplicationVerification {
  id          String   @id @default(uuid())
  email       String   @unique
  code        String
  payloadJson String
  attempts    Int      @default(0)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

model Profile {
  id        String   @id @default(uuid())
  userId    String   @unique
  fullName  String?
  phone     String?
  location  String?
  // Avatar is stored inline (base64) like Vehicle.photoData and
  // MaintenanceRequest.photoData — avatars are small and it keeps the stack
  // free of an object store. The API exposes it as a URL pointing at
  // GET /users/:id/avatar, so clients never handle the blob.
  avatarUrl      String?
  avatarData     String?
  avatarFileType String?

  // ── Community directory ────────────────────────────────────────────────────
  // Opt-in, never on by default: members live here, so being listed is a
  // deliberate choice rather than something to discover and switch off.
  directoryOptIn Boolean @default(false)
  // One-liner — "Building an AI copilot for surgeons".
  headline       String?
  bio            String?
  // JSON arrays/objects kept as strings for SQLite/Postgres portability, the
  // same convention the rest of the schema uses (photoUrlsJson, metadataJson).
  skillsJson     String?
  linksJson      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([directoryOptIn])
}

model Membership {
  id         String           @id @default(uuid())
  userId     String           @unique
  status     String   @default("APPLICANT")
  approvedAt DateTime?
  activatedAt DateTime?
  startingDate DateTime?
  dueDate DateTime?
  finishDate DateTime?
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ResidencyApplication {
  id                    String          @id @default(uuid())
  userId                String          @unique
  externalApplicationId String?
  continueUrl           String?
  status                String   @default("NOT_STARTED")
  stage                 String          @default("Not started")
  requiredNextStepsJson String          @default("[]")
  lastSyncedAt          DateTime?
  lastError             String?
  // Manual proof-of-application flow (no Prospera API): the member applies on
  // prospera.co, then uploads proof here for an admin to verify.
  proofFileName         String?
  proofFileType         String?
  proofData             String?
  submittedAt           DateTime?
  reviewedAt            DateTime?
  reviewNote            String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SubscriptionPlan {
  id                     String     @id @default(uuid())
  userId                 String     @unique
  externalSubscriptionId String?
  planName               String
  status                 String   @default("PENDING")
  renewalDate            DateTime?
  paymentUrl             String?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  user                   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CommunityPlanPurchase {
  id                     String     @id @default(uuid())
  userId                 String
  externalSubscriptionId String?
  planName               String     @default("Builders Node Community Plan")
  status                 String     @default("PENDING")
  amountCents            Int        @default(0)
  currency               String     @default("USD")
  purchasedAt            DateTime   @default(now())
  startsAt               DateTime?
  endsAt                 DateTime?
  renewalDate            DateTime?
  paymentUrl             String?
  source                 String     @default("ProsperaSub.com")
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  user                   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Payment {
  id          String        @id @default(uuid())
  userId      String
  amountCents Int
  currency    String        @default("USD")
  status      String        @default("DUE")
  dueDate     DateTime
  paidAt      DateTime?
  description String
  receiptUrl  String?
  adminNote   String?
  createdAt   DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Apartment {
  id            String                @id @default(uuid())
  name          String
  description   String
  priceCents    Int
  currency      String                @default("USD")
  availability  String   @default("AVAILABLE")
  photoUrlsJson String   @default("[]")
  bedrooms      Int
  bathrooms     Int
  squareFeet    Int?
  availableFrom DateTime?
  unitTypeId    String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  assignments    AssignedApartment[]
  unitType       UnitType?            @relation(fields: [unitTypeId], references: [id])

  @@index([unitTypeId])
}

// A reusable apartment "template" (e.g. Studio, 1 Bedroom) with a shared price
// and specs. Individual units are instances of a type with their own number.
model UnitType {
  id          String      @id @default(uuid())
  name        String
  priceCents  Int         @default(0)
  currency    String      @default("USD")
  bedrooms    Int         @default(0)
  bathrooms   Int         @default(1)
  squareFeet  Int?
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  apartments  Apartment[]
}

model AssignedApartment {
  id           String    @id @default(uuid())
  userId       String    @unique
  apartmentId  String
  moveInDate   DateTime?
  moveOutDate  DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  apartment    Apartment @relation(fields: [apartmentId], references: [id])

  @@index([apartmentId])
}

model MealMenuItem {
  id                     String   @id @default(uuid())
  userId                 String
  day                    String
  meal                   String
  source                 String   @default("ProsperaSub.com")
  // ProsperaSub food_subscriptions row id, once mirrored.
  externalSubscriptionId String?  @unique
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CleaningSchedule {
  id                     String   @id @default(uuid())
  userId                 String
  // The member's standing weekly slot: one weekday (0 = Sunday) and one time
  // from the ProsperaSub package, chosen once. Cleaning recurs on it every week,
  // so `nextCleaning` below is derived from these rather than being a one-off
  // date somebody has to keep re-entering.
  weekday                Int?
  timeSlot               String?
  bookedAt               DateTime?
  nextCleaning           DateTime?
  frequency              String?
  // `notes` is the admin's — it carries the designated plan name. What the
  // member writes for the cleaner (pets, door code, "please skip the study")
  // gets its own column so booking a slot can't wipe the plan.
  notes                  String?
  memberNote             String?
  source                 String   @default("ProsperaSub.com")
  // ProsperaSub cleaning_subscriptions row id, once mirrored.
  externalSubscriptionId String?  @unique
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SupportTicket {
  id         String              @id @default(uuid())
  userId     String
  subject    String
  message    String
  status     String   @default("OPEN")
  adminNote  String?
  resolvedAt DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditEvent {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  metadataJson String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

// Single-row-per-key store for community-wide settings (e.g. the global
// ProsperaSub.com meal plan that applies to every member automatically).
model GlobalSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
