# ── Core ────────────────────────────────────────────────────────────────────
# Postgres. Local dev can use the Postgres in docker-compose.yml.
# Supabase: DATABASE_URL = pooled connection (port 6543, add ?pgbouncer=true),
#           DIRECT_URL   = direct connection (port 5432) — used only for migrations.
DATABASE_URL="postgresql://user:pass@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:pass@host:5432/postgres"
# Long random string used to sign JWTs. Generate: openssl rand -hex 32
JWT_SECRET="replace-with-a-long-random-secret"
# API port and bind host. HOST=0.0.0.0 is required in containers / on a server.
PORT=3000
HOST=0.0.0.0
# Public URL of the frontend — used for CORS. In production set your real domain.
FRONTEND_URL="http://localhost:5173"
# Private key gating admin bootstrap actions.
ADMIN_ACCESS_KEY="replace-with-a-private-admin-key"

# ── Google sign-in (optional) ───────────────────────────────────────────────
# OAuth 2.0 Web client ID (Google Cloud Console). Same value as the frontend's
# VITE_GOOGLE_CLIENT_ID. Leave empty to disable Google login.
GOOGLE_CLIENT_ID=""

# ── Prospera / ProsperaSub integrations ─────────────────────────────────────
PROSPERA_API_BASE_URL="https://prospera.co/api"
PROSPERA_API_KEY=""
# Official ProsperaSub API. PROSPERA_SUB_API_KEY is a privileged server-side secret
# sent as the `x-api-key` header — NEVER expose it to the frontend/browser.
PROSPERA_SUB_API_BASE_URL="https://api.prosperasub.com"
PROSPERA_SUB_API_KEY=""
PROSPERA_SUB_SITE_URL="https://prosperasub.com"
