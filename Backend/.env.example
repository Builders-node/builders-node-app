# ── Core ────────────────────────────────────────────────────────────────────
# Postgres. Local dev can use the Postgres in docker-compose.yml.
# Supabase: DATABASE_URL = pooled connection (port 6543, add ?pgbouncer=true),
#           DIRECT_URL   = direct connection (port 5432) — used only for migrations.
DATABASE_URL="postgresql://user:pass@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:pass@host:5432/postgres"
# Long random string used to sign JWTs. Generate: openssl rand -hex 32
# REQUIRED in production (>= 32 chars) — the app refuses to boot without it.
JWT_SECRET="replace-with-a-long-random-secret"
# API port and bind host. HOST=0.0.0.0 is required in containers / on a server.
PORT=3000
HOST=0.0.0.0
# Public URL of the frontend — used for CORS. In production set your real domain.
# Comma-separated list is supported, e.g. "https://buildersnode.com,https://www.buildersnode.com".
FRONTEND_URL="http://localhost:5173"
# Extra explicit CORS origins (comma-separated), if any beyond FRONTEND_URL.
CORS_EXTRA_ORIGINS=""
# Allow any *.vercel.app origin (needed while serving from the Vercel preview
# domain). Set to "false" once fully on the custom domain to close the hole
# where any Vercel-hosted project could make credentialed requests.
ALLOW_VERCEL_ORIGINS="true"
# Private key gating the admin break-glass header. REQUIRED in production; if
# unset there, the x-admin-key path is disabled and admins use a real session.
ADMIN_ACCESS_KEY="replace-with-a-private-admin-key"

# ── Transactional email (Resend) ────────────────────────────────────────────
# Used for password-reset, email verification, and member invitations. If unset,
# emails are logged instead of sent (nothing breaks — the flow is a no-op).
# Get a key at https://resend.com. MAIL_FROM must be a verified sender/domain.
RESEND_API_KEY=""
MAIL_FROM="Builders Node <noreply@buildersnode.com>"

# ── Discord verification (optional) ─────────────────────────────────────────
# Links a member's Builders Node account to Discord and grants a server role.
# All five below are required to enable it; leave empty to hide the feature.
# Create an app + bot at https://discord.com/developers/applications, invite the
# bot with the "Manage Roles" permission, and put the bot's role ABOVE the roles
# it assigns. REDIRECT_URI must match the one registered in the Discord app and
# point at the API, e.g. https://api.buildersnode.com/auth/discord/callback
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_BOT_TOKEN=""
DISCORD_GUILD_ID=""
DISCORD_REDIRECT_URI=""
# Role ids to assign. MEMBER goes to active members; APPLICANT (optional) to
# everyone else — if APPLICANT is empty, applicants get the MEMBER role too.
DISCORD_ROLE_MEMBER=""
DISCORD_ROLE_APPLICANT=""

# ── Google sign-in (optional) ───────────────────────────────────────────────
# OAuth 2.0 Web client ID (Google Cloud Console). Same value as the frontend's
# VITE_GOOGLE_CLIENT_ID — it's the audience the server checks the ID token was
# issued for, so a mismatch rejects every sign-in. No client *secret* is needed:
# Google Identity Services hands the browser a signed ID token and the server only
# verifies it. Leave empty to disable Google login.
GOOGLE_CLIENT_ID=""

# ── Prospera / ProsperaSub integrations ─────────────────────────────────────
PROSPERA_API_BASE_URL="https://prospera.co/api"
PROSPERA_API_KEY=""
# Official ProsperaSub API. PROSPERA_SUB_API_KEY is a privileged server-side secret
# sent as the `x-api-key` header — NEVER expose it to the frontend/browser.
PROSPERA_SUB_API_BASE_URL="https://api.prosperasub.com"
PROSPERA_SUB_API_KEY=""
PROSPERA_SUB_SITE_URL="https://prosperasub.com"
# Shared secret for the ProsperaSub back-channel
# (POST /integrations/builders-node/subscription). Rotate on both sides
# together. Leave blank to disable the mirror — local grants still succeed.
BUILDERS_NODE_API_SECRET=""
