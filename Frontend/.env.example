# Copy to .env and fill in.

# Backend API base URL (defaults to http://localhost:3000 if unset).
VITE_API_BASE_URL="http://localhost:3001"

# Google OAuth client ID (Google Cloud Console → Credentials → OAuth 2.0 Client ID, "Web application").
# Add http://localhost:5173 to "Authorized JavaScript origins".
# The same value must be set as GOOGLE_CLIENT_ID in Backend/.env.
# Leave empty to hide the "Continue with Google" button.
VITE_GOOGLE_CLIENT_ID=""
