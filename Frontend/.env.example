# Copy to .env and fill in.

# Backend API base URL (defaults to http://localhost:3000 if unset).
VITE_API_BASE_URL="http://localhost:3001"

# Google OAuth client ID (Google Cloud Console → Credentials → OAuth 2.0 Client ID,
# "Web application"). The same value must be set as GOOGLE_CLIENT_ID in Backend/.env —
# the browser uses it to mint the token and the server uses it to verify the token was
# minted for us. Leave empty to hide the "Continue with Google" button.
#
# "Authorized JavaScript origins" must list every origin the button is served from,
# exactly — Google matches on the full origin, and a missing one fails with
# origin_mismatch rather than anything that names the problem:
#   http://localhost:5173
#   https://buildersnode.com
#   https://www.buildersnode.com
# No redirect URIs are needed: this is Google Identity Services, which posts the
# credential back to the page rather than redirecting.
#
# Vite inlines VITE_* at BUILD time, so on Vercel this has to be set before the
# build — adding it afterwards does nothing until the next deploy.
VITE_GOOGLE_CLIENT_ID=""
