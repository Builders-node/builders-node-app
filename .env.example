# Root env for docker-compose.prod.yml. Copy to .env and fill in.
# cp .env.example .env

# ── Database (Supabase / Postgres, required) ─────────────────────────────────
# Supabase → Project Settings → Database → Connection string.
# DATABASE_URL = "Transaction" pooler (port 6543); append ?pgbouncer=true
# DIRECT_URL   = "Session"/direct connection (port 5432) — used for migrations.
DATABASE_URL=          # postgresql://postgres.<ref>:<pass>@<host>:6543/postgres?pgbouncer=true
DIRECT_URL=            # postgresql://postgres.<ref>:<pass>@<host>:5432/postgres

# ── Secrets (required) ───────────────────────────────────────────────────────
JWT_SECRET=            # openssl rand -hex 32
ADMIN_ACCESS_KEY=      # any long private string

# ── Public URLs ──────────────────────────────────────────────────────────────
# Where the web app is served (used for API CORS). Match your domain in prod.
FRONTEND_URL=http://localhost:8080
# Public URL the browser uses to reach the API (baked into the frontend build).
VITE_API_BASE_URL=http://localhost:3000

# ── Google sign-in (optional) ────────────────────────────────────────────────
# Same OAuth Web client ID on both. Empty = Google button hidden.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# ── Integrations (optional) ──────────────────────────────────────────────────
PROSPERA_API_KEY=
PROSPERA_SUB_API_KEY=
